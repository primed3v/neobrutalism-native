{
  "name": "neobrutalism-native",
  "version": "0.1.0",
  "description": "Neobrutalism components for React Native (iOS, Android & Web). A port of neobrutalism.dev.",
  "license": "MIT",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/module/src/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "sideEffects": false,
  "keywords": [
    "react-native",
    "expo",
    "neobrutalism",
    "neo-brutalism",
    "ui",
    "components",
    "design-system"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "example": "npm run --workspace example",
    "prepare": "bob build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-svg": ">=13"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.44.1",
    "typescript": "~6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
